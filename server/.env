# NOTE: Replace these placeholders with your real MySQL credentials.
PORT=3001
NODE_ENV=development

# Allow your Vite dev server origin(s). Comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=room_deserv

# User table/columns (defaults match: users.id, users.username, users.password)
DB_USER_TABLE=users
DB_USER_ID_COL=id
DB_USER_USERNAME_COL=username
DB_USER_PASSWORD_COL=password

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=rd_token

# Legacy support (ONLY if your DB currently stores plaintext passwords)
ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false
